# Main experiment reproduction configuration.
# This reproduces the LegalGraphRAG method only, using the paper case corpus.

model_name=qwen3
device=cuda:0
prompt_language=zh

api_key=
base_url=http://localhost:8000/v1
max_length=4096
temperature=0.1

case_db_path=./datas/main_experiment/cases_with_feature_big.json
law_to_crime_path=./datas/main_experiment/criminal_law_processed.json
datasets_path=./datas/main_experiment
output_dir=./outputs/main_experiment

top_retrieve=True
direct_retrieve=True
augment_retrieve=True
top_retrieve_top_k=5
direct_retrieve_top_k=5

graph_db_path=./outputs/main_experiment/qwen3_graph_db.pkl
embedding_api_url=http://localhost:11434/api/embed
embedding_model=bge-m3
auto_save=True
auto_build=True

